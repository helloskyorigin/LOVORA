# Register your own free account at https://www.geonames.org/login
# Enable free web services in your GeoNames account (commercial use allowed with attribution).
GEONAMES_USERNAME=

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret stable across deploys; rotating it expires existing saved drafts.
BIRTH_SESSION_SECRET=

# Prokerala: https://api.prokerala.com/ - Create production API credentials
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Premium report encrypted storage (Upstash Redis REST; required for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32+ char encryption key; may fall back to BIRTH_SESSION_SECRET (not recommended for rotation).
REPORT_ENCRYPTION_SECRET=

# DEVELOPMENT ONLY, 32+ characters. Never set on a public production deployment.
# POST /api/report/dev-generate returns 404 in production regardless of this key.
LOVORA_DEV_REPORT_SECRET=
