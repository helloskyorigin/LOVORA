# Existing keys: GeoNames, Prokerala, Redis, encryption are also required.
# Copy into server-side environment settings. Never commit real credentials.
GEONAMES_USERNAME=
BIRTH_SESSION_SECRET=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REPORT_ENCRYPTION_SECRET=

# Set only after merchant approval and successful test-mode validation.
LOVORA_PAYMENTS_ENABLED=false
LOVORA_BASE_URL=http://localhost:3000
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_LOVORA_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=

# Local development report testing only.
LOVORA_DEV_REPORT_SECRET=

# Phase 6 — report recovery email (verified Resend sending domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required before opening the real Dodo checkout:
LOVORA_OPERATOR_NAME=
LOVORA_SUPPORT_EMAIL=
